# Copy to .env.local on the laptop that runs the app (Next.js reads it for both
# `npm run dev` and `npm run venue`).

# --- Sign-in PINs (at least 6 characters; share them only with your volunteers) ---
# Desk PIN: desk page only
DESK_PIN=
# Admin PIN: admin page (QR emails, badge totals, arrivals) and the desk
ADMIN_PIN=

# --- Secrets: random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ---
# Signs sign-in sessions (32+ characters)
SESSION_SECRET=
# Derives each guest's ticket id. NEVER change it after QR emails have been sent,
# or the QR codes in those emails stop matching. (16+ characters)
TICKET_SECRET=

# --- Email: sent from your Gmail account with an app password (see README) ---
# Gmail is used only to send the QR emails — nothing else.
GMAIL_USER=you@gmail.com
# 16-character app password from https://myaccount.google.com/apppasswords (spaces are fine)
GMAIL_APP_PASSWORD=
# Optional: where guests' replies go if not your Gmail (also pre-fills the admin test address)
EMAIL_REPLY_TO=

# --- Event details (used in emails and the ticket page) ---
EVENT_NAME=Our Community Event
EVENT_DATE=Saturday 15 November 2026, 5:00 pm
EVENT_VENUE=Community Hall, High Street

# --- Optional ---
# Fixed public address of the app, no trailing slash. Leave EMPTY with a quick
# tunnel (its address changes every run): QR codes then hold just the ticket id,
# which the desk scanner reads the same way, and emails carry no link.
PUBLIC_BASE_URL=
# Where check-ins are stored (default: data/checkin.db)
DB_PATH=
# Use a different responses file, e.g. a sample for a rehearsal (default: data/responses.csv)
RESPONSES_CSV=

# Use a different programme file, e.g. for a rehearsal (default: data/schedule.json)
SCHEDULE_JSON=

# --- Vercel Blob (used on Vercel, which has no disk) -------------------------
# Connect a Blob store to the project in Vercel (Storage → Blob → Connect). With
# the prefix TAMIL_EVENT, Vercel adds these two variables for you. On Vercel the
# responses CSV (uploaded on the Admin page), check-ins and programme statuses
# are kept there as private files. On the laptop they're only used when there's
# no data/responses.csv.
TAMIL_EVENT_STORE_ID=
TAMIL_EVENT_READ_WRITE_TOKEN=
# Only if the store was connected with a different prefix (default TAMIL_EVENT)
BLOB_ENV_PREFIX=
